{
  "name": "Router bus test - reusable internal bus",
  "asio": "ReaRoute ASIO (x64)",
  "buses": [
    {
      "id": "test-bus",
      "name": "Test virtual bus"
    }
  ],
  "sources": [
    {
      "id": "test-src",
      "name": "Test loopback CABLE Input",
      "type": "loopback",
      "endpoint": "CABLE Input (VB-Audio Virtual Cable)"
    },
    {
      "id": "test-bus-src",
      "name": "Test bus source",
      "type": "bus",
      "bus": "test-bus"
    }
  ],
  "destinations": [
    {
      "id": "asio-a",
      "name": "ASIO out 0/1",
      "type": "asio-out",
      "channels": [0, 1]
    },
    {
      "id": "asio-b",
      "name": "ASIO out 2/3",
      "type": "asio-out",
      "channels": [2, 3]
    }
  ],
  "routes": [
    {
      "source": "test-src",
      "destination": "test-bus",
      "gainDb": 0
    },
    {
      "source": "test-bus-src",
      "destination": "asio-a",
      "gainDb": 0
    },
    {
      "source": "test-bus-src",
      "destination": "asio-b",
      "gainDb": -6
    }
  ]
}
