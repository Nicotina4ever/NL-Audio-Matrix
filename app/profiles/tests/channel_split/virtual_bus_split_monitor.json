{
 "name": "Deterministic bus split: bus A -> NL Mic 1, bus B -> NL Mic 2 + NL Mic 3, monitor -> HD Audio",
 "asio": "FlexASIO",
 "version": 3,
 "devices": [
  {
   "id": "flex",
   "backend": "asio",
   "driver": "FlexASIO",
   "sampleRate": 48000,
   "buffer": 256,
   "clockMaster": true
  }
 ],
 "engine": {
  "bufferMode": "balanced"
 },
 "buses": [
  {
   "id": "busA",
   "name": "Bus A"
  },
  {
   "id": "busB",
   "name": "Bus B"
  },
  {
   "id": "busM",
   "name": "Monitor mix"
  }
 ],
 "sources": [
  {
   "id": "s600",
   "name": "Test 600 Hz",
   "type": "test",
   "deviceId": "flex",
   "channels": [
    0,
    1
   ],
   "enabled": true,
   "baseFrequency": 600,
   "testLevel": 0.25
  },
  {
   "id": "s900",
   "name": "Test 900 Hz",
   "type": "test",
   "deviceId": "flex",
   "channels": [
    0,
    1
   ],
   "enabled": true,
   "baseFrequency": 900,
   "testLevel": 0.25
  },
  {
   "id": "busA-src",
   "name": "Bus A source",
   "type": "bus",
   "bus": "busA",
   "enabled": true
  },
  {
   "id": "busB-src",
   "name": "Bus B source",
   "type": "bus",
   "bus": "busB",
   "enabled": true
  },
  {
   "id": "busM-src",
   "name": "Monitor bus source",
   "type": "bus",
   "bus": "busM",
   "enabled": true
  }
 ],
 "destinations": [
  {
   "id": "nlmic1",
   "name": "NL Mic 1",
   "type": "driver",
   "driverEndpoint": 0,
   "channels": [
    0
   ],
   "enabled": true
  },
  {
   "id": "nlmic2",
   "name": "NL Mic 2",
   "type": "driver",
   "driverEndpoint": 1,
   "channels": [
    0
   ],
   "enabled": true
  },
  {
   "id": "nlmic3",
   "name": "NL Mic 3 (duplicate bus B)",
   "type": "driver",
   "driverEndpoint": 2,
   "channels": [
    0
   ],
   "enabled": true
  },
  {
   "id": "monitor",
   "name": "Independent stereo monitor (HD Audio)",
   "type": "render",
   "endpoint": "Altoparlanti (High Definition Audio Device)",
   "channels": [
    0,
    1
   ],
   "enabled": true
  }
 ],
 "routes": [
  {
   "source": "s600",
   "destination": "busA",
   "gainDb": 0,
   "enabled": true
  },
  {
   "source": "s900",
   "destination": "busB",
   "gainDb": 0,
   "enabled": true
  },
  {
   "source": "s600",
   "destination": "busM",
   "gainDb": 0,
   "enabled": true
  },
  {
   "source": "s900",
   "destination": "busM",
   "gainDb": 0,
   "enabled": true
  },
  {
   "source": "busA-src",
   "destination": "nlmic1",
   "gainDb": 0,
   "enabled": true,
   "channelMap": [
    0
   ]
  },
  {
   "source": "busB-src",
   "destination": "nlmic2",
   "gainDb": 0,
   "enabled": true,
   "channelMap": [
    0
   ]
  },
  {
   "source": "busB-src",
   "destination": "nlmic3",
   "gainDb": 0,
   "enabled": true,
   "channelMap": [
    0
   ]
  },
  {
   "source": "busM-src",
   "destination": "monitor",
   "gainDb": -6,
   "enabled": true,
   "channelMap": [
    0,
    1
   ]
  }
 ]
}